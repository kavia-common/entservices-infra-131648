{
    "class": "StorageManager",
    "locator": "libWPEFrameworkStorageManager.so",
    "autostart": @PLUGIN_STORAGE_MANAGER_AUTOSTART@,
    "precondition": [],
    "configuration": {
        "path": "@PLUGIN_STORAGE_MANAGER_PATH@",
        "compose": {
            "persistent": "PersistentStore",
            "shared": "SharedStorage",
            "cloud": "CloudStore"
        }
    }
}
