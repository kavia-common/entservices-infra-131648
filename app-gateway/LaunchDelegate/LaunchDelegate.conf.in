{
  "callsign": "LaunchDelegate",
  "classname": "Plugin_LaunchDelegate",
  "locator": "lib@LIBRARY_NAME@.so",
  "autostart": false,
  "resume": false,
  "configuration": {
    "enabled": true,
    "defaultDelegate": "AppGateway",
    "timeouts": {
      "launchMs": 10000,
      "stopMs": 5000
    }
  }
}
